---
// Served by Cloudflare for any address that doesn't exist (wrangler.jsonc: not_found_handling "404-page").
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Paybook" description="That page doesn't exist. Find federal and military pay by grade, rank, location or job posting." path="/404">
  <main id="main" class="page article">
    <div class="pb-section-label"><b>404</b> · Not found</div>
    <h1>That page doesn't exist</h1>
    <p class="lede">The link may be old or mistyped. Try one of these:</p>
    <div class="links"><div><ul>
      <li><a href="/">Your pay (calculator)</a></li>
      <li><a href="/civilian/gs">GS pay by location</a></li>
      <li><a href="/military/pay-chart">Military pay chart</a> · <a href="/military/bah">BAH</a></li>
      <li><a href="/travel/per-diem">Per diem</a> · <a href="/jobs">Job series</a></li>
    </ul></div></div>
  </main>
</Base>
