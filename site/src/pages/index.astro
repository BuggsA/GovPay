---
// Home: the calculator. Same markup and scripts as sites/ledger (copied into public/ at build).
import Base from "../layouts/Base.astro";
import { G, YEAR } from "../lib/engine.mjs";
// Structured data: the site and its free calculator
const ld = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Paybook", url: "https://paybook.loopi.sh/", description: "Federal and military pay, read like a pay stub." },
  { "@context": "https://schema.org", "@type": "WebApplication", name: "Paybook pay calculator", url: "https://paybook.loopi.sh/", applicationCategory: "FinanceApplication", operatingSystem: "Any", browserRequirements: "Requires JavaScript",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description: `${YEAR} GS, LEO, trades, SES and military pay with locality, BAH, BAS, per diem and take-home pay for every U.S. county, city and ZIP code. Official pay tables.` },
];
const browse = [
  ["/civilian/gs", "GS pay by location", `All ${G.localityAreas(YEAR).length} locality areas, every grade and step`],
  ["/jobs", "Pay by job series", "Every GS occupation, from 0343 to 2210"],
  ["/civilian/trades", "Trades (wage grade) pay", "WG, WL and WS hourly rates for every wage area"],
  ["/military/pay-chart", `${YEAR} military pay chart`, "Basic pay for every rank and years of service"],
  ["/military/bah", "BAH by duty station", "Housing allowance for every area, rank and dependent status"],
  ["/travel/per-diem", "Per diem rates", "Lodging and meals for every state and city"],
];
---
<Base title="Paybook: federal and military pay, read like a pay stub" description="Type your GS grade, rank or a job posting. See your pay, take-home and next raise where you work. Official 2026 GS, military, BAH and per diem tables." path="/" ld={ld}>
  <main id="main" class="page">
    <!-- first visit -->
    <section id="welcome" hidden></section>

    <!-- my pay -->
    <section id="dash" hidden>
      <div class="layout">
        <div class="col-main">
          <div id="ask" class="ask-compact"></div>
          <div class="preview" id="preview" hidden></div>

          <div class="pb-section-label"><b>01</b> · Your pay</div>
          <div class="year-row" id="year"></div>
          <div class="controls" id="controls"></div>
          <button class="pb-place-btn only-mobile" id="placeBtn" type="button" aria-haspopup="dialog"></button>
          <article class="pb-stub" id="stub" aria-live="polite"></article>
          <div id="notes"></div>

          <div class="pb-section-label" style="margin-top:var(--s7)"><b>02</b> · Your next level</div>
          <p class="sub">What your next raise, promotion or role change would pay. Tap one to preview it in your stub.</p>
          <ol class="pb-ladder" id="ladder"></ol>

          <div class="pb-section-label" id="explore" style="margin-top:var(--s7)"><b>03</b> · Explore</div>
          <div class="pb-tabs" role="tablist" aria-label="Explore" id="tabs">
            <button role="tab" data-tab="tables" aria-selected="true">Pay tables</button>
            <button role="tab" data-tab="allowances" aria-selected="false">BAH &amp; BAS</button>
            <button role="tab" data-tab="travel" aria-selected="false">Per diem</button>
            <button role="tab" data-tab="compare" aria-selected="false">Compare</button>
            <button role="tab" data-tab="guide" aria-selected="false">Learn the basics</button>
          </div>
          <div class="tabpanel" id="tabPanel" role="tabpanel"></div>
        </div>
        <aside class="rail" aria-label="Where you work">
          <div class="pb-section-label"><b>04</b> · Where you work</div>
          <div id="pickerRail"></div>
        </aside>
      </div>
    </section>

    <!-- always visible: the reference pages, for people and search engines -->
    <section class="home-browse" aria-labelledby="browseTitle">
      <div class="pb-section-label"><b>{YEAR}</b> · Pay tables</div>
      <h2 id="browseTitle">Browse official federal and military pay</h2>
      <p class="sub">Paybook turns the official pay orders, OPM, DoD, DTMO and GSA tables into one place: civilian GS, law enforcement, trades and SES pay, military basic pay with BAH and BAS, travel per diem, and take-home pay after federal and state taxes. Not affiliated with the U.S. government.</p>
      <ul class="home-browse__list">{browse.map(([href, t, d]) => <li><a href={href}><b>{t}</b><span>{d}</span></a></li>)}</ul>
    </section>
  </main>

  <div class="pb-sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" hidden>
    <div class="pb-sheet__bar"><h2 id="sheetTitle">Where you work</h2><button class="pb-btn pb-btn--line pb-btn--small" id="sheetClose" type="button">Done</button></div>
    <div id="pickerSheet"></div>
  </div>

  <Fragment slot="scripts">
    <script is:inline src="/shared/data/payorder.js"></script>
    <script is:inline src="/shared/data/places.js"></script>
    <script is:inline src="/shared/data/leo.js"></script>
    <script is:inline src="/shared/govpay.js"></script>
    <script is:inline src="/shared/parse.js"></script>
    <script is:inline src="/shared/data/statetax.js"></script>
    <script is:inline src="/shared/tax.js"></script>
    <script is:inline src="/ui/composite.js"></script>
    <script is:inline src="/app.js"></script>
  </Fragment>
</Base>
