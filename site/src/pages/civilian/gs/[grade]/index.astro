---
// One GS grade across every locality area, ranked: /civilian/gs/12
import Base from "../../../../layouts/Base.astro";
import { G, f, YEAR, SOURCE, areaShort } from "../../../../lib/engine.mjs";

export function getStaticPaths() {
  return Array.from({ length: 15 }, (_, i) => ({ params: { grade: String(i + 1) } }));
}
const grade = +Astro.params.grade;
const areas = G.localityAreas(YEAR).map((a) => ({ ...a, s1: G.gsArea(YEAR, grade, 1, a.name), s10: G.gsArea(YEAR, grade, 10, a.name) }))
  .sort((a, b) => b.pct - a.pct);
const top = areas[0], low = areas[areas.length - 1];
const base1 = G.gsBase(YEAR, grade, 1), base10 = G.gsBase(YEAR, grade, 10);
const title = `GS-${grade} pay by location (${YEAR}): all ${areas.length} locality areas`;
const description = `GS-${grade} pay in ${YEAR} ranges from ${f.usd(low.s1.annual)} (${areaShort(low.name)}, step 1) to ${f.usd(top.s10.annual)} (${areaShort(top.name)}, step 10). Base pay is ${f.usd(base1)} to ${f.usd(base10)} before locality pay. Official ${SOURCE[YEAR].label} rates.`;
const path = `/civilian/gs/${grade}`;
const neighbors = [grade - 1, grade + 1].filter((g) => g >= 1 && g <= 15);
---
<Base title={title} description={description} path={path} crumbs={[["GS pay", "/civilian/gs"], [`GS-${grade}`, path]]}>
  <main id="main" class="page article wide">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/civilian/gs">GS pay</a> / GS-{grade}</nav>
    <div class="pb-section-label"><b>GS-{grade}</b> · {YEAR} · Every locality area</div>
    <h1>GS-{grade} pay in every location, {YEAR}</h1>
    <p class="lede">Base pay for a GS-{grade} is <b>{f.usd(base1)}</b> at step 1 and <b>{f.usd(base10)}</b> at step 10 everywhere. Locality pay is added on top, so the same job pays <b>{f.usd(low.s1.annual)}</b> in {areaShort(low.name)} and <b>{f.usd(top.s1.annual)}</b> in {areaShort(top.name)} at step 1.</p>
    <div class="pb-table-wrap">
      <table class="pb-table">
        <thead><tr><th scope="col">Locality area</th><th scope="col">Locality</th><th scope="col">Step 1</th><th scope="col">Step 10</th><th scope="col">Per hour (step 1)</th></tr></thead>
        <tbody>
          {areas.map((a) => (
            <tr><th scope="row"><a class="pb-link pb-link--ink" href={`/civilian/gs/${grade}/${a.slug}`}>{areaShort(a.name)}</a><small class="area-full">{a.name}</small></th><td>{a.pct.toFixed(2)}%</td><td>{f.usd(a.s1.annual)}</td><td>{f.usd(a.s10.annual)}{a.s10.capped && " *"}</td><td>{f.usd2(a.s1.hourly)}</td></tr>
          ))}
        </tbody>
        <caption>{YEAR} yearly pay with locality, highest locality first. {areas.some((a) => a.s10.capped) && "* Capped at Executive Schedule level IV. "}Places not in a named area get the Rest of U.S. rate. Source: <a class="pb-link" href={SOURCE[YEAR].url}>{SOURCE[YEAR].label}</a>, Schedules 1 and 9.</caption>
      </table>
    </div>
    <div class="pb-section-label" style="margin-top:var(--s7)"><b>01</b> · Keep exploring</div>
    <div class="links">
      <div><h2>Other grades</h2><ul>{neighbors.map((g) => <li><a href={`/civilian/gs/${g}`}>GS-{g} in every location</a></li>)}<li><a href="/civilian/gs">All locality areas</a></li></ul></div>
      <div><h2>Popular areas</h2><ul>{["washington-dc", "san-jose-ca", "new-york-ny", "san-diego-ca", "rest-of-us"].map((s) => areas.find((a) => a.slug === s)).filter(Boolean).map((a) => <li><a href={`/civilian/gs/${grade}/${a.slug}`}>GS-{grade} in {areaShort(a.name)}</a></li>)}</ul></div>
    </div>
  </main>
</Base>
