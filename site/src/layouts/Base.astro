---
// Shared page frame: head, header, footer. Uses the same design files as the calculator.
import { breadcrumbLd } from "../lib/engine.mjs";
import { ogPath } from "../lib/cards.mjs";
interface Props { title: string; description: string; path: string; crumbs?: [string, string][]; }
const { title, description, path, crumbs } = Astro.props;
const ld = crumbs && crumbs.length ? JSON.stringify(breadcrumbLd(Astro.site, [["Paybook", "/"], ...crumbs])) : null;
const canonical = new URL(path, Astro.site).toString();
const image = new URL(ogPath(path), Astro.site).toString();   // drawn by scripts/og-images.mjs after the build
const nav = [
  ["/", "My pay"],
  ["/civilian/gs", "GS pay"],
  ["/jobs", "Jobs"],
  ["/military/pay-chart", "Military pay"],
  ["/travel/per-diem", "Per diem"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Paybook">
  <meta property="og:image" content={image}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={title}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={image}>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'%3E%3Cpath d='M3 4h22v7a3 3 0 0 0 0 6v7H3v-7a3 3 0 0 0 0-6z' fill='%231b1a17'/%3E%3Crect x='7' y='11.5' width='14' height='5' fill='%23ffd84d'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=Spline+Sans+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/ui/tokens.css">
  <link rel="stylesheet" href="/ui/components.css">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/pages.css">
  {ld && <script type="application/ld+json" set:html={ld} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="pb-header">
    <div class="pb-header__in">
      <a class="pb-wordmark" href="/" id="home">
        <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path d="M3 4h22v7a3 3 0 0 0 0 6v7H3v-7a3 3 0 0 0 0-6z" fill="none" stroke="currentColor" stroke-width="2"/><rect x="7" y="11.5" width="14" height="5" fill="var(--hi)"/><path d="M8 14h9" stroke="#1b1a17" stroke-width="2"/></svg>
        paybook
      </a>
      <nav class="pb-nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={(href === "/" ? path === "/" : (path === href || path.startsWith(href + "/") || (href === "/military/pay-chart" && path.startsWith("/military/")))) ? "page" : undefined}>{label}</a>)}
      </nav>
      <div class="pb-header__end"><button class="theme-btn" id="theme" type="button" aria-label="Switch light or dark">Dark</button></div>
    </div>
  </header>
  <slot />
  <footer class="pb-footer">
    <div class="pb-footer__in">
      <span><b>paybook</b> is an independent estimate tool. <b>Not affiliated with the U.S. government.</b></span>
      <span>GS, locality, SES and military basic pay: official pay orders (EO 14132, EO 14368) · Per diem: GSA · Take-home: 2026 IRS and state rules · BAH: DTMO · BAS: DoD FMR · Trades: DCPAS · <a href="/about/data">About the data</a></span>
    </div>
  </footer>
  <slot name="scripts" />
  <script is:inline>
    (function () {
      var b = document.getElementById("theme"), r = document.documentElement;
      if (!b || b.dataset.wired) return;
      try { var t = localStorage.getItem("paybook.theme"); if (t) r.dataset.theme = t; } catch (e) {}
      var dark = function () { return r.dataset.theme ? r.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches; };
      b.textContent = dark() ? "Light" : "Dark";
      if (!document.getElementById("dash")) b.onclick = function () { r.dataset.theme = dark() ? "light" : "dark"; b.textContent = dark() ? "Light" : "Dark"; try { localStorage.setItem("paybook.theme", r.dataset.theme); } catch (e) {} };
    })();
  </script>
</body>
</html>
