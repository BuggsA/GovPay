// Cloudflare Workers with static assets. Workers Builds runs `npm run build`, then `npx wrangler deploy`.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paybook",
  "compatibility_date": "2026-10-01",
  // The only server code: anonymous usage events at /api/e (see worker.js and /privacy).
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /civilian/gs/12/san-diego-ca is served from san-diego-ca.html (Astro build.format "file")
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // pages and files are served directly; the script runs only for /api/*
    "run_worker_first": ["/api/*"]
  },
  // Workers Analytics Engine: created on first write; kept 3 months (free plan: 100,000 events a day)
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "paybook_events" }]
}
